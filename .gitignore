# build outputs
build/
pipeline/build/
pipeline/build-sample/
# generated by pipeline/make_gallery.py (CI rebuilds it on deploy)
web/gallery-data/
*.ttf
*.otf
!docs/**/*.ttf
# committed sample font (built by CI from projects/sample/)
!projects/**/*.ttf
# bundled guide font shipped with the studio (unmodified SIL Padauk, OFL)
!web/fonts/*.ttf

# python
__pycache__/
*.pyc
.venv/
venv/

# editors / OS
.DS_Store
.vscode/
.idea/

# scratch build dirs
pipeline/build-*/

# Python packaging build artifacts
*.egg-info/
dist/
build/

# Desktop shell (Electron)
desktop/node_modules/
!desktop/build/
!desktop/build/**

# Mobile shells (Capacitor). The native projects are generated by
# `npx cap add android|ios` and are not committed — only the config is,
# the same way web/gallery-data/ is regenerated rather than stored.
mobile/node_modules/
mobile/android/
mobile/ios/
