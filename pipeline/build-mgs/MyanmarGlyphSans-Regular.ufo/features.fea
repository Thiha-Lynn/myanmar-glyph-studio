# Auto-generated Myanmar shaping features (mym2 starter set).
# Regenerated by json_to_ufo.py — refine by hand as the font matures.
languagesystem DFLT dflt;
languagesystem mym2 dflt;
languagesystem mymr dflt;

feature blwf {
  sub virama-myanmar ka-myanmar by ka-myanmar.sub;
  sub virama-myanmar kha-myanmar by kha-myanmar.sub;
  sub virama-myanmar ga-myanmar by ga-myanmar.sub;
  sub virama-myanmar gha-myanmar by gha-myanmar.sub;
  sub virama-myanmar nga-myanmar by nga-myanmar.sub;
  sub virama-myanmar ca-myanmar by ca-myanmar.sub;
  sub virama-myanmar cha-myanmar by cha-myanmar.sub;
  sub virama-myanmar ja-myanmar by ja-myanmar.sub;
  sub virama-myanmar jha-myanmar by jha-myanmar.sub;
  sub virama-myanmar nya-myanmar by nya-myanmar.sub;
  sub virama-myanmar nnya-myanmar by nnya-myanmar.sub;
  sub virama-myanmar tta-myanmar by tta-myanmar.sub;
  sub virama-myanmar ttha-myanmar by ttha-myanmar.sub;
  sub virama-myanmar dda-myanmar by dda-myanmar.sub;
  sub virama-myanmar ddha-myanmar by ddha-myanmar.sub;
  sub virama-myanmar nna-myanmar by nna-myanmar.sub;
  sub virama-myanmar ta-myanmar by ta-myanmar.sub;
  sub virama-myanmar tha-myanmar by tha-myanmar.sub;
  sub virama-myanmar da-myanmar by da-myanmar.sub;
  sub virama-myanmar dha-myanmar by dha-myanmar.sub;
  sub virama-myanmar na-myanmar by na-myanmar.sub;
  sub virama-myanmar pa-myanmar by pa-myanmar.sub;
  sub virama-myanmar pha-myanmar by pha-myanmar.sub;
  sub virama-myanmar ba-myanmar by ba-myanmar.sub;
  sub virama-myanmar bha-myanmar by bha-myanmar.sub;
  sub virama-myanmar ma-myanmar by ma-myanmar.sub;
  sub virama-myanmar ya-myanmar by ya-myanmar.sub;
  sub virama-myanmar ra-myanmar by ra-myanmar.sub;
  sub virama-myanmar la-myanmar by la-myanmar.sub;
  sub virama-myanmar wa-myanmar by wa-myanmar.sub;
  sub virama-myanmar sa-myanmar by sa-myanmar.sub;
  sub virama-myanmar ha-myanmar by ha-myanmar.sub;
  sub virama-myanmar lla-myanmar by lla-myanmar.sub;
  sub virama-myanmar a-myanmar by a-myanmar.sub;
} blwf;

feature rphf {
  sub nga-myanmar asat-myanmar virama-myanmar by kinzi-myanmar;
} rphf;

@WIDE_BASES = [kha-myanmar gha-myanmar ca-myanmar cha-myanmar jha-myanmar nnya-myanmar ttha-myanmar ddha-myanmar nna-myanmar ta-myanmar tha-myanmar dha-myanmar na-myanmar bha-myanmar ma-myanmar ya-myanmar la-myanmar sa-myanmar ha-myanmar a-myanmar];
feature pres {
  sub medialRa-myanmar' @WIDE_BASES by medialRa-myanmar.wide;
} pres;

@DESC_U = [ka-myanmar.sub kha-myanmar.sub ga-myanmar.sub gha-myanmar.sub nga-myanmar.sub ca-myanmar.sub cha-myanmar.sub ja-myanmar.sub jha-myanmar.sub nya-myanmar.sub nnya-myanmar.sub tta-myanmar.sub ttha-myanmar.sub dda-myanmar.sub ddha-myanmar.sub nna-myanmar.sub ta-myanmar.sub tha-myanmar.sub da-myanmar.sub dha-myanmar.sub na-myanmar.sub pa-myanmar.sub pha-myanmar.sub ba-myanmar.sub bha-myanmar.sub ma-myanmar.sub ya-myanmar.sub ra-myanmar.sub la-myanmar.sub wa-myanmar.sub sa-myanmar.sub ha-myanmar.sub lla-myanmar.sub a-myanmar.sub];
@DESC_UU = [ka-myanmar.sub kha-myanmar.sub ga-myanmar.sub gha-myanmar.sub nga-myanmar.sub ca-myanmar.sub cha-myanmar.sub ja-myanmar.sub jha-myanmar.sub nya-myanmar.sub nnya-myanmar.sub tta-myanmar.sub ttha-myanmar.sub dda-myanmar.sub ddha-myanmar.sub nna-myanmar.sub ta-myanmar.sub tha-myanmar.sub da-myanmar.sub dha-myanmar.sub na-myanmar.sub pa-myanmar.sub pha-myanmar.sub ba-myanmar.sub bha-myanmar.sub ma-myanmar.sub ya-myanmar.sub ra-myanmar.sub la-myanmar.sub wa-myanmar.sub sa-myanmar.sub ha-myanmar.sub lla-myanmar.sub a-myanmar.sub];
feature blws {
  sub @DESC_U u-myanmar' by u-myanmar.alt;
  sub @DESC_UU uu-myanmar' by uu-myanmar.alt;
} blws;
